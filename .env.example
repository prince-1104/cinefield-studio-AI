# ─── Database ───
DATABASE_URL=postgresql+asyncpg://adstudio:adstudio@postgres:5432/adstudio

# ─── ByteDance Seedance Video Generation ───
SEEDANCE_API_KEY=your-seedance-api-key-here
SEEDANCE_RESOURCE_ID=your-seedance-resource-id-here
SEEDANCE_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3
SEEDANCE_DEFAULT_MODEL=seedance-1-0-pro-250528

# ─── Anthropic Claude Creative Planning ───
CLAUDE_API_KEY=your-claude-api-key-here
CLAUDE_MODEL=claude-3-7-sonnet-20250219
PLANNER_PROVIDER=claude

# ─── Provider Execution Controls ───
DEFAULT_VIDEO_PROVIDER=seedance
PROVIDER_REQUEST_TIMEOUT=60.0
VIDEO_POLL_INTERVAL=5.0
VIDEO_GENERATION_TIMEOUT=600.0
MAX_CONCURRENT_JOBS=4
MAX_RETRY_LIMIT=3

# ─── Google Gemini ───
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_TEXT_MODEL=gemini-3.8-flash
GEMINI_VIDEO_MODEL=gemini-omni-1.1-flash

# ─── OpenAI ───
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=coral

# ─── Artifact storage ───
ARTIFACT_DIR=/data/artifacts

# ─── CORS ───
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
